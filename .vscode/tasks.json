      "command": "make subset",
      "problemMatcher": []
    },
    {
      "label": "dev: server (:8000)",
      "type": "shell",
      "command": "make server",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "dev: dashboard (:5173)",
      "type": "shell",
      "command": "make dash",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "dev: stop all services",
      "type": "shell",
      "command": "make stop",
      "problemMatcher": []
    }
  ]
