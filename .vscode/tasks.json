      "type": "shell",
      "command": "make harness-preflight",
      "problemMatcher": []
    },
    {
      "label": "harness: build engines",
      "type": "shell",
      "command": "make engines",
      "problemMatcher": []
    },
    {
      "label": "harness: precompute accuracy",
      "type": "shell",
      "command": "make accuracy",
      "problemMatcher": []
    },
    {
      "label": "harness: run service (:8100)",
